<Window x:Class="MetalBayalaGestion.Views.PaymentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Paiement" Height="450" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Enregistrer un paiement" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="1">
            <TextBox Text="{Binding Payment.Number}" materialDesign:HintAssist.Hint="N° paiement" Margin="0,4" IsReadOnly="True"/>
            <DatePicker SelectedDate="{Binding Payment.Date}" materialDesign:HintAssist.Hint="Date" Margin="0,4"/>
            <ComboBox ItemsSource="{Binding Clients}" SelectedValuePath="Id" DisplayMemberPath="Name" 
                      SelectedValue="{Binding Payment.ClientId}" materialDesign:HintAssist.Hint="Client *" Margin="0,4"/>
            <ComboBox ItemsSource="{Binding Invoices}" SelectedValuePath="Id" DisplayMemberPath="Number" 
                      SelectedValue="{Binding Payment.InvoiceId}" materialDesign:HintAssist.Hint="Facture (optionnel)" Margin="0,4"/>
            <TextBox Text="{Binding Payment.Amount}" materialDesign:HintAssist.Hint="Montant *" Margin="0,4"/>
            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Payment.Mode}" materialDesign:HintAssist.Hint="Mode de paiement" Margin="0,4"/>
            <TextBox Text="{Binding Payment.Reference}" materialDesign:HintAssist.Hint="Référence" Margin="0,4"/>
            <TextBox Text="{Binding Payment.Notes}" materialDesign:HintAssist.Hint="Notes" Margin="0,4" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Enregistrer" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="Annuler" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
    </Grid>
</Window>