<UserControl x:Class="MetalBayalaGestion.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Produits" FontSize="24" FontWeight="Bold" Margin="8"/>

        <ToolBarTray Grid.Row="1" Margin="8,0">
            <ToolBar>
                <Button Command="{Binding AddProductCommand}" ToolTip="Ajouter">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"/>
                        <TextBlock Text="Ajouter"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditProductCommand}" ToolTip="Modifier">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Margin="0,0,4,0"/>
                        <TextBlock Text="Modifier"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteProductCommand}" ToolTip="Supprimer">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Margin="0,0,4,0"/>
                        <TextBlock Text="Supprimer"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedValuePath="Id" DisplayMemberPath="Name" 
                          SelectedValue="{Binding SelectedCategoryId}" Width="150" materialDesign:HintAssist.Hint="Catégorie" Margin="4,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" materialDesign:HintAssist.Hint="Rechercher..." Margin="8,0"/>
                <Button Command="{Binding RefreshCommand}" ToolTip="Actualiser">
                    <materialDesign:PackIcon Kind="Refresh"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <DataGrid Grid.Row="2" Margin="8" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" 
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="Auto"/>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="Auto"/>
                <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                <DataGridTextColumn Header="Catégorie" Binding="{Binding Category.Name}" Width="Auto"/>
                <DataGridTextColumn Header="Prix achat" Binding="{Binding PurchasePrice, StringFormat='{}{0:N0}'}" Width="Auto"/>
                <DataGridTextColumn Header="Prix vente" Binding="{Binding SalePrice, StringFormat='{}{0:N0}'}" Width="Auto"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="Auto"/>
                <DataGridTextColumn Header="Min" Binding="{Binding MinStock}" Width="Auto"/>
                <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="Auto"/>
                <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsActive}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
