<Window x:Class="MetalBayalaGestion.Views.InvoiceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Facture" Height="700" Width="900" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Édition de facture" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <ComboBox ItemsSource="{Binding Clients}" SelectedValuePath="Id" DisplayMemberPath="Name" 
                          SelectedValue="{Binding Invoice.ClientId}" materialDesign:HintAssist.Hint="Client *" Margin="0,4"/>
                <TextBox Text="{Binding Invoice.ClientAddress}" materialDesign:HintAssist.Hint="Adresse client" Margin="0,4"/>
                <TextBox Text="{Binding Invoice.ClientPhone}" materialDesign:HintAssist.Hint="Téléphone client" Margin="0,4"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBox Text="{Binding Invoice.Number}" materialDesign:HintAssist.Hint="N° facture" Margin="0,4" IsReadOnly="True"/>
                <DatePicker SelectedDate="{Binding Invoice.Date}" materialDesign:HintAssist.Hint="Date" Margin="0,4"/>
                <DatePicker SelectedDate="{Binding Invoice.DueDate}" materialDesign:HintAssist.Hint="Échéance" Margin="0,4"/>
                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Invoice.Status}" materialDesign:HintAssist.Hint="Statut" Margin="0,4"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="2" Margin="0,8" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Réf." Binding="{Binding ProductReference}" Width="Auto"/>
                <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="Auto"/>
                <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="Auto"/>
                <DataGridTextColumn Header="P.U." Binding="{Binding UnitPrice, StringFormat='{}{0:N0}'}" Width="Auto"/>
                <DataGridTextColumn Header="Remise" Binding="{Binding Discount, StringFormat='{}{0:N0}'}" Width="Auto"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:N0}'}" Width="Auto"/>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}">
                                <materialDesign:PackIcon Kind="Delete"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Designation" 
                          materialDesign:HintAssist.Hint="Produit" Width="250" Margin="0,0,4,0"/>
                <TextBox Text="{Binding LineQuantity}" materialDesign:HintAssist.Hint="Qté" Width="60" Margin="4,0"/>
                <TextBox Text="{Binding LineDiscount}" materialDesign:HintAssist.Hint="Remise" Width="80" Margin="4,0"/>
                <Button Command="{Binding AddLineCommand}" Margin="4,0">
                    <materialDesign:PackIcon Kind="Plus"/>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Invoice.SubTotal, StringFormat='Sous-total: {0:N0} FCFA'}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Invoice.Discount, StringFormat='Remise: {0:N0} FCFA'}"/>
                <TextBlock Text="{Binding Invoice.TaxAmount, StringFormat='Taxe: {0:N0} FCFA'}"/>
                <TextBlock Text="{Binding Invoice.Total, StringFormat='TOTAL: {0:N0} FCFA'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Enregistrer" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="Annuler" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
    </Grid>
</Window>