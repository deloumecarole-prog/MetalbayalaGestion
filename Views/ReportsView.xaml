<UserControl x:Class="MetalBayalaGestion.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Rapports" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Width="150" md:HintAssist.Hint="Période" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,10,0"/>
            <DatePicker SelectedDate="{Binding StartDate}" md:HintAssist.Hint="Du" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,10,0"/>
            <DatePicker SelectedDate="{Binding EndDate}" md:HintAssist.Hint="Au" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,10,0"/>
            <Button Content="Générer" Command="{Binding GenerateReportCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0"/>
            <Button Content="Imprimer / PDF" Command="{Binding PrintReportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,15">
            <md:Card Padding="15" Margin="5" Background="{DynamicResource PrimaryHueLightBrush}">
                <StackPanel>
                    <TextBlock Text="Total ventes" Opacity="0.7" FontSize="12"/>
                    <TextBlock Text="{Binding TotalSales, StringFormat=N0}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </md:Card>
            <md:Card Padding="15" Margin="5" Background="{DynamicResource SecondaryHueLightBrush}">
                <StackPanel>
                    <TextBlock Text="Total encaissé" Opacity="0.7" FontSize="12"/>
                    <TextBlock Text="{Binding TotalCashIn, StringFormat=N0}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </md:Card>
            <md:Card Padding="15" Margin="5" Background="#ffebee">
                <StackPanel>
                    <TextBlock Text="Créances restantes" Opacity="0.7" FontSize="12"/>
                    <TextBlock Text="{Binding TotalReceivables, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="#c62828"/>
                </StackPanel>
            </md:Card>
            <md:Card Padding="15" Margin="5" Background="#fff3e0">
                <StackPanel>
                    <TextBlock Text="Total dépenses" Opacity="0.7" FontSize="12"/>
                    <TextBlock Text="{Binding TotalExpenses, StringFormat=N0}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </md:Card>
            <md:Card Padding="15" Margin="5" Background="#e8f5e9">
                <StackPanel>
                    <TextBlock Text="Solde caisse" Opacity="0.7" FontSize="12"/>
                    <TextBlock Text="{Binding CashBalance, StringFormat=N0}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </md:Card>
        </UniformGrid>

        <TabControl Grid.Row="3" Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="Mouvements de stock">
                <DataGrid ItemsSource="{Binding StockMovements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="Produit" Binding="{Binding Product.Designation}" Width="250"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Qté" Binding="{Binding Quantity, StringFormat=0.##}" Width="80"/>
                        <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="150"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Stock bas">
                <DataGrid ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="120"/>
                        <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity, StringFormat=0.##}" Width="100"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding MinStock, StringFormat=0.##}" Width="100"/>
                        <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
