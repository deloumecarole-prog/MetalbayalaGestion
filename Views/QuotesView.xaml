<UserControl x:Class="MetalBayalaGestion.Views.QuotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Devis" FontSize="24" FontWeight="Bold" Margin="8"/>

        <ToolBarTray Grid.Row="1" Margin="8,0">
            <ToolBar>
                <Button Command="{Binding AddQuoteCommand}" ToolTip="Créer">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"/>
                        <TextBlock Text="Créer"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditQuoteCommand}" ToolTip="Modifier">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Margin="0,0,4,0"/>
                        <TextBlock Text="Modifier"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteQuoteCommand}" ToolTip="Supprimer">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Margin="0,0,4,0"/>
                        <TextBlock Text="Supprimer"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding PrintQuoteCommand}" ToolTip="Exporter PDF">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,4,0"/>
                        <TextBlock Text="PDF"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ConvertToInvoiceCommand}" ToolTip="Convertir en facture">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileSwap" Margin="0,0,4,0"/>
                        <TextBlock Text="Convertir"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <ComboBox Width="120" ItemsSource="{Binding Statuses}" SelectedItem="{Binding StatusFilter}" materialDesign:HintAssist.Hint="Statut" Margin="4,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" materialDesign:HintAssist.Hint="Rechercher..." Margin="8,0"/>
                <Button Command="{Binding RefreshCommand}" ToolTip="Actualiser">
                    <materialDesign:PackIcon Kind="Refresh"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <DataGrid Grid.Row="2" Margin="8" ItemsSource="{Binding Quotes}" SelectedItem="{Binding SelectedQuote}" 
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="Auto"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto"/>
                <DataGridTextColumn Header="Client" Binding="{Binding Client.Name}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:N0}'}" Width="Auto"/>
                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="Auto"/>
                <DataGridTextColumn Header="Validité" Binding="{Binding ValidUntil, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
