<UserControl x:Class="MetalBayalaGestion.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Paramètres" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

            <materialDesign:Card Padding="16" Margin="0,8">
                <StackPanel>
                    <TextBlock Text="Entreprise" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Company.Name}" materialDesign:HintAssist.Hint="Nom de l'entreprise" Margin="0,4"/>
                    <TextBox Text="{Binding Company.Address}" materialDesign:HintAssist.Hint="Adresse" Margin="0,4"/>
                    <TextBox Text="{Binding Company.City}" materialDesign:HintAssist.Hint="Ville" Margin="0,4"/>
                    <TextBox Text="{Binding Company.Phone}" materialDesign:HintAssist.Hint="Téléphone" Margin="0,4"/>
                    <TextBox Text="{Binding Company.WhatsApp}" materialDesign:HintAssist.Hint="WhatsApp" Margin="0,4"/>
                    <TextBox Text="{Binding Company.Email}" materialDesign:HintAssist.Hint="Email" Margin="0,4"/>
                    <TextBox Text="{Binding Company.Nif}" materialDesign:HintAssist.Hint="NIF" Margin="0,4"/>
                    <TextBox Text="{Binding Company.Rccm}" materialDesign:HintAssist.Hint="RCCM" Margin="0,4"/>
                    <TextBox Text="{Binding Company.TaxInfo}" materialDesign:HintAssist.Hint="Informations fiscales" Margin="0,4"/>
                    <TextBox Text="{Binding Company.DocumentFooter}" materialDesign:HintAssist.Hint="Pied de page documents" Margin="0,4" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    <Button Content="Enregistrer les paramètres" Command="{Binding SaveCompanyCommand}" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="16" Margin="0,8">
                <StackPanel>
                    <TextBlock Text="Sauvegarde" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DbPath}" Opacity="0.6" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Sauvegarder la base" Command="{Binding BackupDatabaseCommand}" Margin="0,0,8,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
                        <Button Content="Restaurer une sauvegarde" Command="{Binding RestoreDatabaseCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>