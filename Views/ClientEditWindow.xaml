<Window x:Class="MetalBayalaGestion.Views.ClientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Client" Height="500" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Fiche client" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBox Text="{Binding Client.Code}" materialDesign:HintAssist.Hint="Code client" Margin="0,4" IsReadOnly="True"/>
                <TextBox Text="{Binding Client.Name}" materialDesign:HintAssist.Hint="Nom / Raison sociale *" Margin="0,4"/>
                <TextBox Text="{Binding Client.Contact}" materialDesign:HintAssist.Hint="Contact" Margin="0,4"/>
                <TextBox Text="{Binding Client.Phone}" materialDesign:HintAssist.Hint="Téléphone" Margin="0,4"/>
                <TextBox Text="{Binding Client.WhatsApp}" materialDesign:HintAssist.Hint="WhatsApp" Margin="0,4"/>
                <TextBox Text="{Binding Client.Email}" materialDesign:HintAssist.Hint="Email" Margin="0,4"/>
                <TextBox Text="{Binding Client.Address}" materialDesign:HintAssist.Hint="Adresse" Margin="0,4" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                <TextBox Text="{Binding Client.City}" materialDesign:HintAssist.Hint="Ville" Margin="0,4"/>
                <TextBox Text="{Binding Client.Nif}" materialDesign:HintAssist.Hint="NIF" Margin="0,4"/>
                <TextBox Text="{Binding Client.Rccm}" materialDesign:HintAssist.Hint="RCCM" Margin="0,4"/>
                <TextBox Text="{Binding Client.Notes}" materialDesign:HintAssist.Hint="Notes" Margin="0,4" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Enregistrer" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="Annuler" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
    </Grid>
</Window>
