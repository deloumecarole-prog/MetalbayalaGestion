<Window x:Class="MetalBayalaGestion.Views.CashTransactionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Transaction caisse" Height="450" Width="450" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Mouvement de caisse" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="1">
            <DatePicker SelectedDate="{Binding Transaction.Date}" materialDesign:HintAssist.Hint="Date" Margin="0,4"/>
            <TextBox Text="{Binding Transaction.Label}" materialDesign:HintAssist.Hint="Libellé *" Margin="0,4"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Transaction.Category}" materialDesign:HintAssist.Hint="Catégorie" Margin="0,4"/>
            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Transaction.Type}" materialDesign:HintAssist.Hint="Type (Entrée/Sortie)" Margin="0,4"/>
            <TextBox Text="{Binding Transaction.Amount}" materialDesign:HintAssist.Hint="Montant *" Margin="0,4"/>
            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Transaction.Mode}" materialDesign:HintAssist.Hint="Mode de paiement" Margin="0,4"/>
            <TextBox Text="{Binding Transaction.Reference}" materialDesign:HintAssist.Hint="Référence" Margin="0,4"/>
            <TextBox Text="{Binding Transaction.Notes}" materialDesign:HintAssist.Hint="Notes" Margin="0,4" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Enregistrer" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="Annuler" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
    </Grid>
</Window>