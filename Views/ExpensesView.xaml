<UserControl x:Class="MetalBayalaGestion.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dépenses" FontSize="24" FontWeight="Bold" Margin="8"/>

        <ToolBarTray Grid.Row="1" Margin="8,0">
            <ToolBar>
                <Button Command="{Binding AddExpenseCommand}" ToolTip="Ajouter">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"/>
                        <TextBlock Text="Ajouter"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditExpenseCommand}" ToolTip="Modifier">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Margin="0,0,4,0"/>
                        <TextBlock Text="Modifier"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteExpenseCommand}" ToolTip="Supprimer">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Margin="0,0,4,0"/>
                        <TextBlock Text="Supprimer"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding RefreshCommand}" ToolTip="Actualiser">
                    <materialDesign:PackIcon Kind="Refresh"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <DataGrid Grid.Row="2" Margin="8" ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}" 
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto"/>
                <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="Auto"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Montant" Binding="{Binding Amount, StringFormat='{}{0:N0}'}" Width="Auto"/>
                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>