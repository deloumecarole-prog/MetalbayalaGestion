<UserControl x:Class="MetalBayalaGestion.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="Tableau de bord" FontSize="28" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- KPI Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <materialDesign:Card Margin="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="CA Aujourd'hui" Opacity="0.6" FontSize="12"/>
                        <TextBlock Text="{Binding TodaySales, StringFormat='{}{0:N0} FCFA'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="CA Ce mois" Opacity="0.6" FontSize="12"/>
                        <TextBlock Text="{Binding MonthSales, StringFormat='{}{0:N0} FCFA'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Clients" Opacity="0.6" FontSize="12"/>
                        <TextBlock Text="{Binding ClientCount}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Produits" Opacity="0.6" FontSize="12"/>
                        <TextBlock Text="{Binding ProductCount}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Devis en attente" Opacity="0.6" FontSize="12"/>
                        <TextBlock Text="{Binding PendingQuotes}" FontSize="20" FontWeight="Bold" Foreground="Orange"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Factures impayées" Opacity="0.6" FontSize="12"/>
                        <TextBlock Text="{Binding UnpaidInvoices}" FontSize="20" FontWeight="Bold" Foreground="Red"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Créances clients" Opacity="0.6" FontSize="12"/>
                        <TextBlock Text="{Binding TotalReceivables, StringFormat='{}{0:N0} FCFA'}" FontSize="20" FontWeight="Bold" Foreground="Red"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Margin="4" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Stock faible" Opacity="0.6" FontSize="12"/>
                        <TextBlock Text="{Binding LowStockCount}" FontSize="20" FontWeight="Bold" Foreground="DarkOrange"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recent Invoices -->
                <materialDesign:Card Grid.Column="0" Margin="4" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Dernières factures" FontWeight="Bold" Margin="8"/>
                        <DataGrid ItemsSource="{Binding RecentInvoices}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="Auto"/>
                                <DataGridTextColumn Header="Client" Binding="{Binding Client.Name}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:N0}'}" Width="Auto"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Recent Quotes -->
                <materialDesign:Card Grid.Column="1" Margin="4" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Derniers devis" FontWeight="Bold" Margin="8"/>
                        <DataGrid ItemsSource="{Binding RecentQuotes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="N°" Binding="{Binding Number}" Width="Auto"/>
                                <DataGridTextColumn Header="Client" Binding="{Binding Client.Name}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:N0}'}" Width="Auto"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Low Stock Alert -->
            <materialDesign:Card Margin="4,8,4,4" Padding="8">
                <StackPanel>
                    <TextBlock Text="Alertes stock faible" FontWeight="Bold" Margin="8" Foreground="DarkOrange"/>
                    <DataGrid ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="Auto"/>
                            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="Auto"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding MinStock}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
