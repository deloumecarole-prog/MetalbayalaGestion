<Window x:Class="MetalBayalaGestion.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Produit" Height="500" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Fiche produit" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBox Text="{Binding Product.Reference}" materialDesign:HintAssist.Hint="Référence" Margin="0,4"/>
                <TextBox Text="{Binding Product.Code}" materialDesign:HintAssist.Hint="Code" Margin="0,4"/>
                <TextBox Text="{Binding Product.Designation}" materialDesign:HintAssist.Hint="Désignation *" Margin="0,4"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedValuePath="Id" DisplayMemberPath="Name" 
                          SelectedValue="{Binding Product.CategoryId}" materialDesign:HintAssist.Hint="Catégorie *" Margin="0,4"/>
                <TextBox Text="{Binding Product.Description}" materialDesign:HintAssist.Hint="Description" Margin="0,4" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                <TextBox Text="{Binding Product.PurchasePrice}" materialDesign:HintAssist.Hint="Prix d'achat" Margin="0,4"/>
                <TextBox Text="{Binding Product.SalePrice}" materialDesign:HintAssist.Hint="Prix de vente" Margin="0,4"/>
                <TextBox Text="{Binding Product.Unit}" materialDesign:HintAssist.Hint="Unité" Margin="0,4"/>
                <TextBox Text="{Binding Product.StockQuantity}" materialDesign:HintAssist.Hint="Stock actuel" Margin="0,4"/>
                <TextBox Text="{Binding Product.MinStock}" materialDesign:HintAssist.Hint="Stock minimum" Margin="0,4"/>
                <ComboBox ItemsSource="{Binding Suppliers}" SelectedValuePath="Id" DisplayMemberPath="Name" 
                          SelectedValue="{Binding Product.SupplierId}" materialDesign:HintAssist.Hint="Fournisseur" Margin="0,4"/>
                <CheckBox Content="Actif" IsChecked="{Binding Product.IsActive}" Margin="0,4"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Enregistrer" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="Annuler" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="4" Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
    </Grid>
</Window>
