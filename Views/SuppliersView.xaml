<UserControl x:Class="MetalBayalaGestion.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Fournisseurs" FontSize="24" FontWeight="Bold" Margin="8"/>

        <ToolBarTray Grid.Row="1" Margin="8,0">
            <ToolBar>
                <Button Command="{Binding AddSupplierCommand}" ToolTip="Ajouter">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"/>
                        <TextBlock Text="Ajouter"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditSupplierCommand}" ToolTip="Modifier">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Margin="0,0,4,0"/>
                        <TextBlock Text="Modifier"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteSupplierCommand}" ToolTip="Supprimer">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Margin="0,0,4,0"/>
                        <TextBlock Text="Supprimer"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" materialDesign:HintAssist.Hint="Rechercher..." Margin="8,0"/>
                <Button Command="{Binding RefreshCommand}" ToolTip="Actualiser">
                    <materialDesign:PackIcon Kind="Refresh"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <DataGrid Grid.Row="2" Margin="8" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" 
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="Auto"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Contact" Binding="{Binding Contact}" Width="Auto"/>
                <DataGridTextColumn Header="Téléphone" Binding="{Binding Phone}" Width="Auto"/>
                <DataGridTextColumn Header="Ville" Binding="{Binding City}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
