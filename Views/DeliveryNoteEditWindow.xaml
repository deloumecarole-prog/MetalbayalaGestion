<Window x:Class="MetalBayalaGestion.Views.DeliveryNoteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Bon de sortie" Height="550" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Bon de sortie" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Clients}" SelectedValue="{Binding DeliveryNote.ClientId}" SelectedValuePath="Id" DisplayMemberPath="Name" md:HintAssist.Hint="Client" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,5,0"/>
            <TextBox Grid.Column="1" Text="{Binding DeliveryNote.DeliveryAddress}" md:HintAssist.Hint="Adresse de livraison" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5,0,5,0"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding Statuses}" SelectedItem="{Binding DeliveryNote.Status}" md:HintAssist.Hint="Statut" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="5,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Designation" md:HintAssist.Hint="Produit" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,5,0"/>
            <TextBox Grid.Column="1" Text="{Binding LineQuantity}" md:HintAssist.Hint="Quantité" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5,0,5,0"/>
            <Button Grid.Column="2" Content="Ajouter" Command="{Binding AddLineCommand}" Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Bottom"/>
        </Grid>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource MaterialDesignDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
                <DataGridTextColumn Header="Qté" Binding="{Binding Quantity, StringFormat=0.##}" Width="100"/>
                <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="100"/>
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Suppr" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignFlatButton}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBox Grid.Row="4" Text="{Binding DeliveryNote.Notes}" md:HintAssist.Hint="Notes" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,10,0,0" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Enregistrer" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,10,0"/>
            <Button Content="Annuler" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
    </Grid>
</Window>
