<Window x:Class="MetalBayalaGestion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Metal Bayala Gestion - V1.0" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Background="{DynamicResource PrimaryHueDarkBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar fixe (plus de DrawerHost : evite le voile semi-transparent permanent) -->
        <Border Grid.Column="0" Width="260"
                Background="{DynamicResource PrimaryHueMidBrush}"
                Visibility="{Binding IsMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="16" Background="{DynamicResource PrimaryHueDarkBrush}">
                    <StackPanel>
                        <TextBlock Text="METAL BAYALA" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Gestion Commerciale" FontSize="12" Foreground="White" Opacity="0.8"/>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MenuItems}" Margin="0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalContentAlignment="Left"
                                        HorizontalAlignment="Stretch"
                                        Padding="16,12"
                                        Foreground="White"
                                        Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Title}" FontSize="14"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Background="{DynamicResource MaterialDesignPaper}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ToolBarTray Grid.Row="0" Background="{DynamicResource MaterialDesignToolBarBackground}">
                <ToolBar Style="{StaticResource MaterialDesignToolBar}">
                    <Button Command="{Binding ToggleMenuCommand}" ToolTip="Menu">
                        <materialDesign:PackIcon Kind="Menu" />
                    </Button>
                    <Separator/>
                    <TextBlock Text="{Binding CurrentTitle}" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="8,0"/>
                    <Separator/>
                    <TextBlock Text="{Binding CurrentUserDisplay}" VerticalAlignment="Center" Margin="8,0" Opacity="0.7"/>
                    <Button Command="{Binding LogoutCommand}" ToolTip="D茅connexion">
                        <materialDesign:PackIcon Kind="Logout" />
                    </Button>
                </ToolBar>
            </ToolBarTray>
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="16"/>
        </Grid>
    </Grid>
</Window>
